      "id": "7f28ac56-9da8-4ca5-a81e-5abc22e6f1f5",
      "name": "Is New Article?"
    },
    {
      "parameters": {
        "jsCode": "\nconst categories = {\n  acquisition: [\n    \"acquired\", \"acquires\", \"acquisition\",\n    \"merger\", \"merged\", \"takeover\"\n  ],\n  funding: [\n    \"funding\", \"raised\", \"investment\",\n    \"series a\", \"series b\", \"series c\"\n  ],\n  partnership: [\n    \"partnership\", \"partnered\", \"collaboration\",\n    \"joint venture\"\n  ],\n  leadership: [\n    \"new ceo\", \"appointed\", \"new cfo\",\n    \"steps down\", \"resigned\"\n  ],\n  expansion: [\n    \"expansion\", \"new office\", \"new factory\",\n    \"expanding\", \"new market\"\n  ],\n  layoffs: [\n    \"layoffs\", \"job cuts\", \"workforce reduction\",\n    \"restructuring\"\n  ]\n};\n\n\nreturn $input.all().map(item => {\n  const article = item.json;\n\n  const text = [\n    article.title || \"\",\n    article.description || \"\",\n    article.content || \"\"\n  ].join(\" \").toLowerCase();\n\n  let eventType = \"other\";\n  let matchedKeywords = [];\n\n  for (const [category, keywords] of Object.entries(categories)) {\n    const matches = keywords.filter(keyword =>\n      text.includes(keyword)\n    );\n\n    if (matches.length > 0) {\n      eventType = category;\n      matchedKeywords = matches;\n      break;\n    }\n  }\n\n  return {\n    json: {\n      ...article,\n      event_type: eventType,\n      matched_keywords: matchedKeywords,\n      classification_method: \"rule_based\",\n      is_significant: eventType !== \"other\"\n    }\n  };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        -192
      ],
      "id": "73898477-fe91-441d-85e7-b54b66be2d30",
