      "name": "Normalize Article"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH inserted AS (\n    INSERT INTO observations (\n        company_id,\n        source_type,\n        source_url,\n        title,\n        content,\n        published_at\n    )\n    VALUES ($1, $2, $3, $4, $5, $6)\n    ON CONFLICT (company_id, source_url)\n    DO NOTHING\n    RETURNING id\n)\nSELECT\n    EXISTS (SELECT 1 FROM inserted) AS is_new,\n    (SELECT id FROM inserted LIMIT 1) AS observation_id,\n    $1::bigint AS company_id,\n    $2::text AS source_type,\n    $3::text AS source_url,\n    $4::text AS title,\n    $5::text AS content,\n    $6::timestamptz AS published_at,\n    $7::text AS company_name;",
        "options": {
          "queryBatching": "independently",
          "queryReplacement": "={{ [\n  $json.company_id,\n  $json.source_type,\n  $json.source_url,\n  $json.title,\n  $json.content,\n  $json.published_at,\n  $json.company_name\n] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        672,
        -96
      ],
      "id": "44255612-ee18-46fe-a800-8d231183cdae",
      "name": "Save New Observations"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "a2ec2639-fce3-4f6d-afce-17ea0efc552b",
              "leftValue": "={{ $json.is_new }}",
              "rightValue": "",
