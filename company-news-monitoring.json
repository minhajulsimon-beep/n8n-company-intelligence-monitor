            {
              "id": "8a3b1880-cfc6-488a-88aa-23f6860631bf",
              "leftValue": "={{ $json.is_significant }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
