    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "\nINSERT INTO public.events (\n    company_id,\n    observation_id,\n    event_type,\n    title,\n    summary,\n    event_date,\n    status,\n    matched_keywords,\n    classification_method,\n    is_significant\n)\nSELECT\n    $1::bigint,\n    $2::bigint,\n    $3::text,\n    $4::text,\n    NULL,\n    $5::timestamptz::date,\n    'candidate',\n    $6::jsonb,\n    'rule_based',\n    TRUE\nWHERE NOT EXISTS (\n    SELECT 1\n    FROM public.events\n    WHERE observation_id = $2::bigint\n);\n",
        "options": {
          "queryReplacement": "={{ [\n  $json.company_id,\n  $json.observation_id,\n  $json.event_type,\n  $json.title,\n  $json.published_at || null,\n  JSON.stringify($json.matched_keywords || [])\n] }}",
          "queryBatching": "independently"
        }
      },
